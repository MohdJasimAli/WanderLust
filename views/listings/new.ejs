<%- layout("layouts/boilerplate") %>

<div class="row">
  <div class="col-8 offset-2">
    <h1 class="mb-4">Create New Listing</h1>

    <form
      action="/listings"
      method="POST"
      enctype="multipart/form-data"
      class="needs-validation"
      novalidate
    >

      <!-- TITLE -->
      <div class="mb-3">
        <label class="form-label">Title</label>
        <input
          name="listing[title]"
          type="text"
          class="form-control"
          required
        />
      </div>

      <!-- DESCRIPTION -->
      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea
          name="listing[description]"
          class="form-control"
          rows="4"
          required
        ></textarea>
      </div>

      <!-- IMAGE -->
      <div class="mb-3">
        <label class="form-label">Upload Listing Image</label>
       <input
  type="file"
  name="image"
  class="form-control"
  accept="image/*"
/>
      </div>

      <!-- PRICE -->
      <div class="mb-3">
        <label class="form-label">Price</label>
        <input
          name="listing[price]"
          type="number"
          class="form-control"
          min="0"
          required
        />
      </div>

      <!-- COUNTRY -->
      <div class="mb-3">
        <label class="form-label">Country</label>
        <input
          name="listing[country]"
          type="text"
          class="form-control"
          required
        />
      </div>

      <!-- LOCATION -->
      <div class="mb-3">
        <label class="form-label">Location</label>
        <input
          name="listing[location]"
          type="text"
          class="form-control"
          required
        />
      </div>

      <!-- CATEGORY -->
      <div class="mb-3">
        <label class="form-label">Category</label>
       <select name="listing[category]" class="form-control" required>
  <option value="">Select a category</option>
  <option value="Trending">Trending</option>
  <option value="Room">Room</option>
  <option value="Artic">Artic</option>
  <option value="Iconic Cities">Iconic Cities</option>
  <option value="Pools">Pools</option>
  <option value="Mountains">Mountains</option>
  <option value="Farms">Farms</option>
  <option value="Campings">Campings</option>
  <option value="Castles">Castles</option>
</select>

      </div>

      <button class="btn btn-dark">Add Listing</button>
    </form>
  </div>
</div>
