<%- layout("layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-md-6 offset-md-3">

    <!-- LISTING CARD -->
    <div class="card shadow-lg mb-4">
      <% if (listing.image && listing.image.url) { %>
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="<%= listing.title %>"
          style="height: 20rem; object-fit: cover;"
        />
      <% } %>

      <div class="card-body">
        <p class="card-text">
          OWNED BY: <i><%= listing.owner.username %></i>
        </p>
        <h3 class="card-title"><%= listing.title %></h3>
        <p class="card-text"><%= listing.description %></p>
        <p>
          <strong>Price:</strong>
          ₹<%= listing.price.toLocaleString("en-IN") %> / night
        </p>
        <p>
          <strong>Location:</strong>
          <%= listing.location %>, <%= listing.country %>
        </p>
      </div>
    </div>

    <!-- ACTION BUTTONS -->
    <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
      <div class="mb-3">
        <a
          href="/listings/<%= listing._id %>/edit"
          class="btn btn-dark me-2"
        >
          Edit
        </a>

        <form
          method="POST"
          action="/listings/<%= listing._id %>?_method=DELETE"
          class="d-inline"
        >
          <button class="btn btn-danger">Delete</button>
        </form>
      </div>
    <% } %>

    <hr />

    <!-- REVIEW FORM -->
    <% if (currUser) { %>
      <h4>Leave a Review</h4>

      <form
        method="POST"
        action="/listings/<%= listing._id %>/reviews"
        class="needs-validation"
        novalidate
      >
        <div class="mb-3">
          <label class="form-label">Your Review</label>
          <textarea
            name="review[comment]"
            class="form-control"
            rows="3"
            required
          ></textarea>
          <div class="invalid-feedback">Please write a review.</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Rating</label>
          <fieldset class="starability-fade">
            <% for (let i = 1; i <= 5; i++) { %>
              <input
                type="radio"
                id="rate-<%= i %>"
                name="review[rating]"
                value="<%= i %>"
                required
              />
              <label for="rate-<%= i %>"><%= i %> star</label>
            <% } %>
          </fieldset>
        </div>

        <button class="btn btn-primary">Submit Review</button>
      </form>
    <% } %>

    <hr />

    <!-- ALL REVIEWS -->
    <h4>All Reviews</h4>

    <div class="row">
      <% if (listing.reviews.length === 0) { %>
        <p class="text-muted">No reviews yet.</p>
      <% } %>

      <% for (let rev of listing.reviews) { %>
        <div class="card col-md-5 ms-2 mb-3">
          <div class="card-body">
            <h5 class="card-title"><%= rev.author.username %></h5>
            <p class="starability-result" data-rating="<%= rev.rating %>"></p>
            <p class="card-text"><%= rev.comment %></p>
          </div>

          <% if (currUser && currUser._id.equals(rev.author._id)) { %>
            <form
              method="POST"
              action="/listings/<%= listing._id %>/reviews/<%= rev._id %>?_method=DELETE"
              class="ms-3 mb-3"
            >
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>
